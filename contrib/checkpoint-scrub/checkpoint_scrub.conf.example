# Configuration for checkpoint_scrub.sh

# Pool to scrub
POOL=tank

# full (-f) or incremental (-i)
MODE=incremental

# TXGS per incremental window (-s)
STEP=10000

# Seconds between incremental windows (-b)
BREATH=60

# zdb space limit in kilobytes (-M).
MEMLIMIT_KB=8388608

# Where the scrub cursor is kept (-S).
#STATE_FILE=/var/lib/checkpoint_scrub/tank.state

# Commands to use, e.g. from a build tree.
#ZPOOL=zpool
#ZDB=zdb

# Extra zdb options
#ZDB_OPTS="-I 64"
